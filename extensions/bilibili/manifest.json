{
  "manifest_version": 3,
  "name": "UNI",
  "version": "0.1.0",
  "description": "Capture Bilibili frames and send OCR requests to the UNI sidecar.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "tabs", "scripting", "storage"],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "https://www.bilibili.com/*",
    "http://127.0.0.1:17321/*",
    "http://localhost:17321/*"
  ],
  "optional_host_permissions": ["http://*/*"],
  "action": {
    "default_title": "UNI",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup/popup.html"
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://*.bilibili.com/*", "https://www.bilibili.com/*"],
      "css": ["src/overlay.css"],
      "js": ["src/overlay.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "capture-ocr-pipeline": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "截图并执行 OCR + 分词"
    }
  }
}
